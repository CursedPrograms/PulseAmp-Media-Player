{
  // Midnight Neon: a full player (playlist, now playing, visualizer, equalizer)
  // over a neon photo. Layout: 1536 x 1024 skin pixels, opened at a size that
  // fits comfortably on the screen (Zoom in the right-click menu changes it).
  // Pages: now, playlist, visualizer, library, online (the tabs along the top).
  "name": "Midnight Neon",
  "author": "Farica Kimora / Cursed Entertainment",
  "width": 1536,
  "height": 1024,
  "background": "background.jpg",
  "shape": "rounded",
  "corner_radius": 16,
  "accent": "#00ff8c",
  "start_page": "now",

  "controls": [
    // ── Top bar ──────────────────────────────────────────────────────────────
    { "type": "button", "action": "menu", "icon": "logo", "rect": [18, 12, 84, 60] },
    { "type": "text", "text": "Pulse{#ff3cc8}Amp", "rect": [104, 8, 250, 52], "font_size": 40,
      "color": "#ffffff", "glow": "#ff3cc8" },
    { "type": "text", "text": "M E D I A    P L A Y E R", "rect": [108, 54, 240, 20], "font_size": 13,
      "color": "#9aa0b8" },

    { "type": "toggle", "action": "page:now", "text": "Now Playing", "rect": [354, 27, 113, 36],
      "font_size": 15, "color": "#e8e8f2", "background": "#00000055", "border": "#ffffff55",
      "background_on": "#00ff8c", "color_on": "#04130b", "border_on": "#00ff8c", "glow": "#00ff8c",
      "background_hover": "#ffffff14", "radius": 6 },
    { "type": "toggle", "action": "page:playlist", "text": "Playlist", "rect": [479, 27, 92, 36],
      "font_size": 15, "color": "#e8e8f2", "background": "#00000055", "border": "#ffffff55",
      "background_on": "#00ff8c", "color_on": "#04130b", "border_on": "#00ff8c", "glow": "#00ff8c",
      "background_hover": "#ffffff14", "radius": 6 },
    { "type": "toggle", "action": "page:visualizer", "text": "Visualizer", "rect": [582, 27, 109, 36],
      "font_size": 15, "color": "#e8e8f2", "background": "#00000055", "border": "#ffffff55",
      "background_on": "#00ff8c", "color_on": "#04130b", "border_on": "#00ff8c", "glow": "#00ff8c",
      "background_hover": "#ffffff14", "radius": 6 },
    { "type": "toggle", "action": "page:library", "text": "Library", "rect": [703, 27, 92, 36],
      "font_size": 15, "color": "#e8e8f2", "background": "#00000055", "border": "#ffffff55",
      "background_on": "#00ff8c", "color_on": "#04130b", "border_on": "#00ff8c", "glow": "#00ff8c",
      "background_hover": "#ffffff14", "radius": 6 },
    { "type": "toggle", "action": "page:online", "text": "Online", "rect": [807, 27, 90, 36],
      "font_size": 15, "color": "#e8e8f2", "background": "#00000055", "border": "#ffffff55",
      "background_on": "#00ff8c", "color_on": "#04130b", "border_on": "#00ff8c", "glow": "#00ff8c",
      "background_hover": "#ffffff14", "radius": 6 },

    { "type": "search", "rect": [991, 27, 251, 36], "radius": 18, "hint": "Search music...",
      "background": "#00000077", "border": "#ffffff33", "color": "#e8e8f2", "color2": "#8a8aa0",
      "glow": "#00ff8c" },
    { "type": "button", "action": "menu", "icon": "gear", "rect": [1268, 25, 40, 40], "shape": "circle",
      "color": "#d0d0e0", "color_hover": "#ffffff", "border": "#ffffff44", "background": "#00000055",
      "background_hover": "#ffffff14" },

    { "type": "button", "action": "minimize", "icon": "minimize", "rect": [1398, 8, 34, 34],
      "color": "#c8c8d8", "color_hover": "#ffffff" },
    { "type": "button", "action": "maximize", "icon": "maximize", "rect": [1443, 8, 34, 34],
      "color": "#c8c8d8", "color_hover": "#ffffff" },
    { "type": "button", "action": "close", "icon": "close", "rect": [1488, 8, 34, 34],
      "color": "#c8c8d8", "color_hover": "#ff5a6a" },

    // ── Left: playlist / library / online / favorites ───────────────────────
    { "type": "panel", "rect": [24, 97, 364, 788], "radius": 14, "background": "#0b0c14cc",
      "border": "#00ff8c66", "glow": "#00ff8c", "glow_size": 9 },
    { "type": "toggle", "action": "list:playlist", "text": "Playlist", "rect": [40, 104, 70, 34],
      "font_size": 15, "color": "#b8b8c8", "color_on": "#00ff8c", "color_hover": "#ffffff",
      "underline": true, "fill": "#00ff8c", "glow": "#00ff8c" },
    { "type": "toggle", "action": "list:library", "text": "Library", "rect": [118, 104, 66, 34],
      "font_size": 15, "color": "#b8b8c8", "color_on": "#00ff8c", "color_hover": "#ffffff",
      "underline": true, "fill": "#00ff8c", "glow": "#00ff8c" },
    { "type": "toggle", "action": "list:online", "text": "Online", "rect": [192, 104, 64, 34],
      "font_size": 15, "color": "#b8b8c8", "color_on": "#00ff8c", "color_hover": "#ffffff",
      "underline": true, "fill": "#00ff8c", "glow": "#00ff8c" },
    { "type": "toggle", "action": "list:favorites", "text": "Favorites  ♡", "rect": [262, 104, 110, 34],
      "font_size": 15, "color": "#b8b8c8", "color_on": "#00ff8c", "color_hover": "#ffffff",
      "underline": true, "fill": "#00ff8c", "glow": "#00ff8c" },
    { "type": "list", "source": "left", "rect": [34, 146, 350, 670], "row_height": 66, "font_size": 16,
      "color": "#e8e8f2", "color2": "#8e8ea8", "color_on": "#00ff8c", "fill": "#00ff8c",
      "background_on": "#00ff8c1f", "border_on": "#00ff8caa", "glow": "#00ff8c" },

    { "type": "button", "action": "add", "icon": "plus", "rect": [42, 834, 40, 40],
      "color": "#00ff8c", "color_hover": "#8affc4", "glow": "#00ff8c" },
    { "type": "toggle", "action": "shuffle", "icon": "shuffle", "rect": [104, 834, 40, 40],
      "color": "#00ff8c99", "color_on": "#00ff8c", "color_hover": "#8affc4" },
    { "type": "toggle", "action": "repeat", "icon": "repeat", "rect": [166, 834, 40, 40],
      "color": "#00ff8c99", "color_on": "#00ff8c", "color_hover": "#8affc4" },
    { "type": "button", "action": "more", "icon": "more", "rect": [228, 834, 40, 40],
      "color": "#d0d0e0", "color_hover": "#ffffff" },

    // ── Bottom left: mini now-playing card ───────────────────────────────────
    { "type": "panel", "rect": [24, 903, 364, 100], "radius": 14, "background": "#0b0c14cc",
      "border": "#00ff8c66", "glow": "#00ff8c", "glow_size": 9 },
    { "type": "art", "rect": [36, 915, 76, 76], "radius": 8 },
    { "type": "text", "content": "title", "rect": [124, 918, 200, 24], "font_size": 17, "color": "#f0f0f8",
      "scroll": true },
    { "type": "text", "content": "artist", "rect": [124, 943, 200, 20], "font_size": 14, "color": "#9a9ab4" },
    { "type": "toggle", "action": "favorite", "icon": "heart", "rect": [330, 914, 40, 40],
      "color": "#ff3cc8", "color_hover": "#ff7ad9", "glow": "#ff3cc8" },
    { "type": "visualizer", "mode": "spectrum", "rect": [124, 966, 244, 28], "fill": "#00ff8c",
      "video": false },

    // ── Now Playing page ─────────────────────────────────────────────────────
    { "type": "panel", "pages": ["now"], "rect": [928, 97, 582, 364], "radius": 14,
      "background": "#0b0c14cc", "border": "#ffffff26", "glow": "#ff3cc8", "glow_size": 8 },
    { "type": "art", "pages": ["now"], "rect": [950, 120, 197, 192], "radius": 6, "glow": "#ff3cc8",
      "glow_size": 10 },
    { "type": "text", "pages": ["now"], "content": "title", "rect": [1174, 124, 276, 48], "font_size": 34,
      "color": "#ffffff", "scroll": true },
    { "type": "text", "pages": ["now"], "content": "artist", "rect": [1174, 170, 300, 36], "font_size": 24,
      "color": "#c8c8d8" },
    { "type": "toggle", "pages": ["now"], "action": "favorite", "icon": "heart", "rect": [1452, 112, 44, 44],
      "color": "#ff3cc8", "color_hover": "#ff7ad9", "glow": "#ff3cc8" },
    { "type": "text", "pages": ["now"], "content": "album", "rect": [1174, 226, 300, 26], "font_size": 17,
      "color": "#a8a8c0" },
    { "type": "text", "pages": ["now"], "content": "format", "rect": [1174, 258, 330, 26], "font_size": 15,
      "color": "#8e8ea8" },

    { "type": "slider", "pages": ["now"], "action": "seek", "rect": [951, 336, 536, 5], "radius": 7,
      "background": "#ffffff26", "fill": "#00ff8c", "color": "#00ff8c", "glow": "#00ff8c" },
    { "type": "text", "pages": ["now"], "content": "time", "rect": [951, 348, 100, 22], "font_size": 15,
      "color": "#c8c8d8" },
    { "type": "text", "pages": ["now"], "content": "duration", "rect": [1387, 348, 100, 22], "font_size": 15,
      "color": "#c8c8d8", "align": "right" },

    { "type": "toggle", "pages": ["now"], "action": "shuffle", "icon": "shuffle", "rect": [946, 385, 42, 42],
      "color": "#00ff8c99", "color_on": "#00ff8c", "color_hover": "#8affc4" },
    { "type": "button", "pages": ["now"], "action": "prev", "icon": "prev", "rect": [1036, 384, 44, 44],
      "color": "#ffffff", "color_hover": "#00ff8c" },
    { "type": "toggle", "pages": ["now"], "action": "playpause", "rect": [1106, 367, 78, 78], "shape": "circle",
      "border": "#00ff8c", "border_width": 3, "color": "#00ff8c", "color_hover": "#8affc4",
      "background_hover": "#00ff8c14", "glow": "#00ff8c", "glow_size": 12 },
    { "type": "button", "pages": ["now"], "action": "next", "icon": "next", "rect": [1210, 384, 44, 44],
      "color": "#ffffff", "color_hover": "#00ff8c" },
    { "type": "toggle", "pages": ["now"], "action": "mute", "icon": "volume", "rect": [1296, 385, 40, 40],
      "color": "#d0d0e0", "color_on": "#ff5a6a", "color_hover": "#ffffff" },
    { "type": "slider", "pages": ["now"], "action": "volume", "rect": [1348, 402, 139, 4], "radius": 6,
      "background": "#ffffff26", "fill": "#00ff8c", "color": "#00ff8c", "glow": "#00ff8c" },

    { "type": "panel", "pages": ["now"], "rect": [940, 478, 570, 234], "radius": 14,
      "background": "#0b0c14b3", "border": "#ffffff26", "glow": "#01dcff", "glow_size": 8 },
    { "type": "visualizer", "pages": ["now"], "mode": "neon", "rect": [952, 492, 546, 206] },

    { "type": "panel", "pages": ["now"], "rect": [1008, 730, 502, 242], "radius": 14,
      "background": "#0b0c14cc", "border": "#ffffff26", "glow": "#00ff8c", "glow_size": 6 },
    { "type": "text", "pages": ["now"], "text": "Equalizer", "rect": [1030, 748, 200, 30], "font_size": 19,
      "color": "#ffffff" },
    { "type": "switch", "pages": ["now"], "action": "eq_toggle", "rect": [1252, 752, 40, 22],
      "fill": "#00ff8c", "color": "#ffffff", "glow": "#00ff8c", "glow_size": 6 },
    { "type": "combo", "pages": ["now"], "rect": [1320, 746, 168, 34], "radius": 6,
      "background": "#00000077", "border": "#ffffff33", "color": "#d8d8e8", "fill": "#00ff8c" },
    { "type": "eq", "pages": ["now"], "rect": [1022, 794, 474, 166], "radius": 8, "font_size": 15,
      "color2": "#b0b0c4" },

    // ── Playlist page ────────────────────────────────────────────────────────
    { "type": "panel", "pages": ["playlist"], "rect": [928, 97, 582, 875], "radius": 14,
      "background": "#0b0c14d9", "border": "#00ff8c66", "glow": "#00ff8c", "glow_size": 9 },
    { "type": "text", "pages": ["playlist"], "text": "Playlist", "rect": [952, 110, 300, 44], "font_size": 28,
      "color": "#ffffff", "glow": "#00ff8c" },
    { "type": "list", "pages": ["playlist"], "source": "playlist", "rect": [940, 164, 562, 796],
      "row_height": 72, "font_size": 18, "color": "#e8e8f2", "color2": "#8e8ea8", "color_on": "#00ff8c",
      "fill": "#00ff8c", "background_on": "#00ff8c1f", "border_on": "#00ff8caa", "glow": "#00ff8c" },

    // ── Visualizer page ──────────────────────────────────────────────────────
    { "type": "panel", "pages": ["visualizer"], "rect": [412, 97, 1098, 875], "radius": 14,
      "background": "#05050acc", "border": "#01dcff55", "glow": "#01dcff", "glow_size": 10 },
    { "type": "visualizer", "pages": ["visualizer"], "mode": "current", "rect": [422, 107, 1078, 855],
      "radius": 10, "fill": "#00ff8c" },

    // ── Library page ─────────────────────────────────────────────────────────
    { "type": "panel", "pages": ["library"], "rect": [928, 97, 582, 875], "radius": 14,
      "background": "#0b0c14d9", "border": "#00ff8c66", "glow": "#00ff8c", "glow_size": 9 },
    { "type": "text", "pages": ["library"], "text": "Library", "rect": [952, 110, 300, 44], "font_size": 28,
      "color": "#ffffff", "glow": "#00ff8c" },
    { "type": "list", "pages": ["library"], "source": "library", "rect": [940, 164, 562, 796],
      "row_height": 72, "font_size": 18, "color": "#e8e8f2", "color2": "#8e8ea8", "color_on": "#00ff8c",
      "fill": "#00ff8c", "background_on": "#00ff8c1f", "border_on": "#00ff8caa", "glow": "#00ff8c" },

    // ── Online page ──────────────────────────────────────────────────────────
    { "type": "panel", "pages": ["online"], "rect": [928, 97, 582, 875], "radius": 14,
      "background": "#0b0c14d9", "border": "#ff3cc866", "glow": "#ff3cc8", "glow_size": 9 },
    { "type": "text", "pages": ["online"], "text": "Online", "rect": [952, 110, 200, 44], "font_size": 28,
      "color": "#ffffff", "glow": "#ff3cc8" },
    { "type": "text", "pages": ["online"], "text": "Type in the search box and press Enter", "rect": [1110, 118, 380, 30],
      "font_size": 14, "color": "#8e8ea8", "align": "right" },
    { "type": "list", "pages": ["online"], "source": "online", "rect": [940, 164, 562, 796],
      "row_height": 72, "font_size": 18, "color": "#e8e8f2", "color2": "#8e8ea8", "color_on": "#ff3cc8",
      "fill": "#ff3cc8", "background_on": "#ff3cc81f", "border_on": "#ff3cc8aa", "glow": "#ff3cc8" }
  ]
}
